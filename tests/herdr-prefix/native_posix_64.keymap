#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    chosen {
        zmk,matrix-transform = &transform;
    };

    /* op36 position N is RC(N/10, N%10); thumbs 30..35 are row 3. */
    transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };
};

&kscan {
    rows = <4>;
    columns = <10>;
    events = <
        /* lead-in so require-prior-idle-ms sees real idle time */
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,400)

        /* cmbru, a tap on thumbs 31+34, leaves en for ru */
        ZMK_MOCK_PRESS(3,1,5)
        ZMK_MOCK_PRESS(3,4,20)
        ZMK_MOCK_RELEASE(3,1,10)
        ZMK_MOCK_RELEASE(3,4,300)

        /* The herdr prefix, exactly as it is typed: hold the right Ctrl
           (pos 17) long enough for the hold to resolve on the timer, then tap
           B (pos 4), then let Ctrl go. The prefix is Ctrl+B; Ctrl+Space is the
           language switch now and must not be confused for it. Position 4 is B
           on en and е on ru, so 0x05 here also proves the modifier raised
           en_letters for the prefix key itself. */
        ZMK_MOCK_PRESS(1,7,350)
        ZMK_MOCK_PRESS(0,4,30)
        ZMK_MOCK_RELEASE(0,4,30)
        ZMK_MOCK_RELEASE(1,7,1500)

        /* The command key, 1500 ms after the prefix — herdr shows a prompt and
           you read it before choosing, so this gap is the realistic one. An
           earlier version of this case waited 150 ms and therefore never
           noticed that sken's release-after-ms expired first.

           Position 1 is W on en and й on ru, so 0x1A proves the prefix held en
           and 0x14 proves it did not. That is a scancode, not a character: the
           host decides which glyph 0x1A becomes, and on "Русская" it is ц. The
           host half of this feature is herdr's own
           switch_ascii_input_source_in_prefix, which nothing here can test. */
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,300)

        /* Same position again: ru must be back, so this one has to be й. */
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,300)

        /* Prefix again, this time followed by Shift+R: right Shift on pos 18,
           R on pos 11. The sticky must survive the Shift press, or R arrives
           as Cyrillic. */
        ZMK_MOCK_PRESS(1,7,350)
        ZMK_MOCK_PRESS(0,4,30)
        ZMK_MOCK_RELEASE(0,4,30)
        ZMK_MOCK_RELEASE(1,7,150)
        ZMK_MOCK_PRESS(1,8,200)
        ZMK_MOCK_PRESS(1,1,30)
        ZMK_MOCK_RELEASE(1,1,30)
        ZMK_MOCK_RELEASE(1,8,300)

        /* And ru is back afterwards. */
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,200)
    >;
};

#include "/cfg/op36_ruen.keymap"
