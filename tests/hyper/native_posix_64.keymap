#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    chosen {
        zmk,matrix-transform = &transform;
    };

    /* op36 position N is RC(N/10, N%10); thumbs 30..35 are row 3. */
    transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };
};&kscan {
    rows = <4>;
    columns = <10>;
    events = <
        /* lead-in so require-prior-idle-ms sees real idle time */
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,400)

        /* Hold F (pos 2) past the 280 ms term, then chord M (pos 15, opposite
           hand and a plain &kp). All four modifiers must appear as separate
           0xE0..0xE3 keycodes and still be down when M is sent — that is the
           whole point of building Hyper from four &kp instead of implicit
           mods on one. */
        ZMK_MOCK_PRESS(0,2,350)
        ZMK_MOCK_PRESS(1,5,30)
        ZMK_MOCK_RELEASE(1,5,30)
        ZMK_MOCK_RELEASE(0,2,300)

        /* Tapped, F is still f. */
        ZMK_MOCK_PRESS(0,2,50)
        ZMK_MOCK_RELEASE(0,2,300)

        /* Hold U (pos 7) and chord G (pos 14) the other way round. */
        ZMK_MOCK_PRESS(0,7,350)
        ZMK_MOCK_PRESS(1,4,30)
        ZMK_MOCK_RELEASE(1,4,30)
        ZMK_MOCK_RELEASE(0,7,300)

        /* The layout switch has moved to the thumbs, so positions 2+3 carry
           nothing special any more: this must type f and p, with no switch
           and no layer change. Position 2 is purely Hyper now. */
        ZMK_MOCK_PRESS(0,2,5)
        ZMK_MOCK_PRESS(0,3,30)
        ZMK_MOCK_RELEASE(0,2,10)
        ZMK_MOCK_RELEASE(0,3,200)
    >;
};

#include "/cfg/op36_ruen.keymap"
