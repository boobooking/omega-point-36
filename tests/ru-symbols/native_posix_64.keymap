#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    chosen {
        zmk,matrix-transform = &transform;
    };

    /* op36 position N is RC(N/10, N%10); thumbs 30..35 are row 3. */
    transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };
};

&kscan {
    rows = <4>;
    columns = <10>;
    events = <
        /* lead-in so require-prior-idle-ms sees real idle time */
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,400)

        /* position 30 leaves en for ru */
        ZMK_MOCK_PRESS(3,0,30)
        ZMK_MOCK_RELEASE(3,0,300)

        /* Hold Esc (pos 32) to raise sym_ru, which must be layer 4 and not
           layer 3. Then every symbol the macOS "Русская" layout moves off the
           PC ЙЦУКЕН position: ? (5), * (10), / (15), : (23), ; (24), % (25),
           , (26), . (27) and \\ (28). Positions 23 and 26 are the ru_ext
           entrances on ru, and 10 is a home row mod, so sym_ru has to win over
           all three. * and \\ have no key in this layout and go through &en,
           so they bracket themselves in Caps Lock. */
        ZMK_MOCK_PRESS(3,2,350)
        ZMK_MOCK_PRESS(0,5,30)
        ZMK_MOCK_RELEASE(0,5,30)
        ZMK_MOCK_PRESS(1,5,30)
        ZMK_MOCK_RELEASE(1,5,30)
        ZMK_MOCK_PRESS(2,3,30)
        ZMK_MOCK_RELEASE(2,3,30)
        ZMK_MOCK_PRESS(2,4,30)
        ZMK_MOCK_RELEASE(2,4,30)
        ZMK_MOCK_PRESS(2,5,30)
        ZMK_MOCK_RELEASE(2,5,30)
        ZMK_MOCK_PRESS(2,6,30)
        ZMK_MOCK_RELEASE(2,6,30)
        ZMK_MOCK_PRESS(2,7,30)
        ZMK_MOCK_RELEASE(2,7,30)

        /* * (pos 10) and \\ (pos 28) go through &en, which flips the host with
           Caps Lock, types on ABC and flips back. The macro is asynchronous and
           carries wait-ms = 50, so these two are spaced like a human reaching
           for a symbol rather than rolled at 30 ms — at 30 ms the macro's own
           key lands after the following one, and that next key gets typed while
           the host is still on ABC. */
        ZMK_MOCK_PRESS(1,0,200)
        ZMK_MOCK_RELEASE(1,0,200)
        ZMK_MOCK_PRESS(2,8,200)
        ZMK_MOCK_RELEASE(2,8,200)
        ZMK_MOCK_RELEASE(3,2,300)

        /* The other entrance, Enter (pos 33), must reach the same layer. */
        ZMK_MOCK_PRESS(3,3,350)
        ZMK_MOCK_PRESS(0,5,30)
        ZMK_MOCK_RELEASE(0,5,30)
        ZMK_MOCK_RELEASE(3,3,300)

        /* Back on ru afterwards: pos 1 is й. */
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,200)
    >;
};

#include "/cfg/op36_ruen.keymap"
