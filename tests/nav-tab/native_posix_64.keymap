#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    chosen {
        zmk,matrix-transform = &transform;
    };

    /* op36 position N is RC(N/10, N%10); thumbs 30..35 are row 3. */
    transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };
};

&kscan {
    rows = <4>;
    columns = <10>;
    events = <
        /* lead-in so require-prior-idle-ms sees real idle time */
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,400)

        /* Tab stays on nav at position 14, right of &kp RIGHT, on the hand the
           right thumb leaves free. Escape has left the layer: position 10, the
           other flank of the arrows, is &none now, and Escape lives on the
           thumb cluster alone.

           Hold 34 past the tapping term, then press all three. Position 10
           must emit nothing, the arrow at 11 is 0x50, and Tab is 0x2B. */
        ZMK_MOCK_PRESS(3,4,300)
        ZMK_MOCK_PRESS(1,0,30)
        ZMK_MOCK_RELEASE(1,0,30)
        ZMK_MOCK_PRESS(1,1,30)
        ZMK_MOCK_RELEASE(1,1,30)
        ZMK_MOCK_PRESS(1,4,30)
        ZMK_MOCK_RELEASE(1,4,30)

        /* Escape is still one key away from here: position 32 is &trans on
           nav, so it falls through to the base layer's &ltt L_SYM_EN ESC and
           taps 0x29 with nav still held. That fall-through is what makes "on
           the thumb cluster on every layer" true. */
        ZMK_MOCK_PRESS(3,2,30)
        ZMK_MOCK_RELEASE(3,2,30)
        ZMK_MOCK_RELEASE(3,4,300)

        /* With 34 up, the same three positions are ordinary letters again:
           A (0x04), R (0x15) and G (0x0A) on en. */
        ZMK_MOCK_PRESS(1,0,30)
        ZMK_MOCK_RELEASE(1,0,30)
        ZMK_MOCK_PRESS(1,1,30)
        ZMK_MOCK_RELEASE(1,1,30)
        ZMK_MOCK_PRESS(1,4,30)
        ZMK_MOCK_RELEASE(1,4,300)
    >;
};

#include "/cfg/op36_ruen.keymap"
