#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    chosen {
        zmk,matrix-transform = &transform;
    };

    /* op36 position N is RC(N/10, N%10); thumbs 30..35 are row 3. */
    transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };
};

&kscan {
    rows = <4>;
    columns = <10>;
    events = <
        /* lead-in so require-prior-idle-ms sees real idle time */
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,400)

        /* Position 35 is &ltadj L_ADJ 0: tap-preferred, so adj only comes up
           once the 200 ms tapping term has passed. Held that long, pos 1 must
           resolve on the adj layer as the bluetooth behavior; released,
           ordinary letters come back. The profile keys sit on the left hand
           because the thumb that holds adj is on the right, so the probe is a
           left-hand position. */
        ZMK_MOCK_PRESS(3,5,250)
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,30)
        ZMK_MOCK_RELEASE(3,5,300)

        /* Tapped instead of held, position 35 emits nothing at all — its tap
           binding is &none — and adj never comes up. That emptiness is why the
           key stays a hold-tap instead of becoming a plain &mo: tap-preferred
           makes a roll resolve as a tap, so the letter that follows lands on
           the base layer rather than on adj, where &bootloader sits at position
           10 and the BT profile keys at 1 and 2. */
        ZMK_MOCK_PRESS(3,5,30)
        ZMK_MOCK_RELEASE(3,5,30)
        ZMK_MOCK_PRESS(0,6,30)
        ZMK_MOCK_RELEASE(0,6,300)

        /* Pos 6 is L on en once the key is up. */
        ZMK_MOCK_PRESS(0,6,30)
        ZMK_MOCK_RELEASE(0,6,300)

        /* Holding Space then Backspace gives numbers with nav over it, never
           adj. They are no longer a combo either, so nothing switches. */
        ZMK_MOCK_PRESS(3,1,300)
        ZMK_MOCK_PRESS(3,4,300)
        ZMK_MOCK_PRESS(0,6,30)
        ZMK_MOCK_RELEASE(0,6,30)
        ZMK_MOCK_RELEASE(3,4,30)
        ZMK_MOCK_RELEASE(3,1,200)
    >;
};

#include "/cfg/op36_ruen.keymap"
