#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    chosen {
        zmk,matrix-transform = &transform;
    };

    /* op36 position N is RC(N/10, N%10); thumbs 30..35 are row 3. */
    transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };
};&kscan {
    rows = <4>;
    columns = <10>;
    events = <
        /* lead-in so require-prior-idle-ms sees real idle time */
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,400)

        /* tap position 32 to leave en for ru */
        ZMK_MOCK_PRESS(3,2,30)
        ZMK_MOCK_RELEASE(3,2,300)

        /* hold Space (pos 31) past the tapping term to raise numbers_ru */
        ZMK_MOCK_PRESS(3,1,300)

        /* unshifted first: pos 27 is still a plain 2 (0x1F, no implicit mods) */
        ZMK_MOCK_PRESS(2,7,30)
        ZMK_MOCK_RELEASE(2,7,30)

        /* now hold the left Shift (pos 11) and walk the morphs. Each one has to
           come out as Option+digit — implicit_mods 0x04 — because that is where
           "Русская" keeps the English symbol. Shift+digit there would give the
           Cyrillic punctuation instead. */
        ZMK_MOCK_PRESS(1,1,30)

        /* pos 27 -> @, Option+2 */
        ZMK_MOCK_PRESS(2,7,30)
        ZMK_MOCK_RELEASE(2,7,30)

        /* pos 17 -> %, Option+5 */
        ZMK_MOCK_PRESS(1,7,30)
        ZMK_MOCK_RELEASE(1,7,30)

        /* pos 7 -> *, Option+8 */
        ZMK_MOCK_PRESS(0,7,30)
        ZMK_MOCK_RELEASE(0,7,30)

        /* pos 26 -> !, and pos 8 -> ( : these two carry no morph, because
           Shift+1 and Shift+9 already agree between ABC and "Русская". They
           must arrive as bare digits with the Shift left to the host. */
        ZMK_MOCK_PRESS(2,6,30)
        ZMK_MOCK_RELEASE(2,6,30)
        ZMK_MOCK_PRESS(0,8,30)
        ZMK_MOCK_RELEASE(0,8,30)

        ZMK_MOCK_RELEASE(1,1,30)

        /* The shortcut case, and the reason the morphs are nested. Cmd (pos 13)
           and Shift (pos 11) held together over a digit must reach the host as
           Cmd+Shift+digit — a plain 0x21 with implicit_mods 0x00 — and not as
           Cmd+Option+digit. A single mod-morph gave the latter, because its
           condition is a bitwise AND and fires on any Shift, which broke every
           screenshot shortcut on ru while leaving en untouched.

           pos 16 is 4, pos 27 is 2; both must behave. */
        ZMK_MOCK_PRESS(1,3,30)
        ZMK_MOCK_PRESS(1,1,30)
        ZMK_MOCK_PRESS(1,6,30)
        ZMK_MOCK_RELEASE(1,6,30)
        ZMK_MOCK_PRESS(2,7,30)
        ZMK_MOCK_RELEASE(2,7,30)
        ZMK_MOCK_RELEASE(1,1,30)
        ZMK_MOCK_RELEASE(1,3,30)

        ZMK_MOCK_RELEASE(3,1,400)
    >;
};

#include "/cfg/op36_ruen.keymap"
