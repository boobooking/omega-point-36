#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    chosen {
        zmk,matrix-transform = &transform;
    };

    /* op36 position N is RC(N/10, N%10); thumbs 30..35 are row 3. */
    transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };
};&kscan {
    rows = <4>;
    columns = <10>;
    events = <
        /* lead-in so require-prior-idle-ms sees real idle time */
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,400)

        /* Escape lives on the tap of Shift, position 11, and this case measures
           how long that tap may last. Space is held throughout, because that is
           the only way to reach the layer, and the tap is made with the same
           hand as the thumb holding it — which is why it takes longer than a
           tap normally would.

           Balanced with no other key in play decides on the timer, so the
           tapping term is the whole question. At 200 ms a 250 ms press became a
           silent Shift and the key looked dead on the device; at 500 ms all
           four of these resolve as taps and emit 0x29.

           The term costs nothing elsewhere: with a digit in play the hold is
           decided by that key's release, never by the timer, which is why
           numbers-ru-symbols did not move when this changed. */
        ZMK_MOCK_PRESS(3,1,250)

        ZMK_MOCK_PRESS(1,1,100)
        ZMK_MOCK_RELEASE(1,1,120)
        ZMK_MOCK_PRESS(1,1,150)
        ZMK_MOCK_RELEASE(1,1,120)
        ZMK_MOCK_PRESS(1,1,250)
        ZMK_MOCK_RELEASE(1,1,120)
        ZMK_MOCK_PRESS(1,1,400)
        ZMK_MOCK_RELEASE(1,1,120)

        ZMK_MOCK_RELEASE(3,1,400)
    >;
};

#include "/cfg/op36_ruen.keymap"
