#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    chosen {
        zmk,matrix-transform = &transform;
    };

    /* op36 position N is RC(N/10, N%10); thumbs 30..35 are row 3. */
    transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };
};&kscan {
    rows = <4>;
    columns = <10>;
    events = <
        /* lead-in so require-prior-idle-ms sees real idle time */
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,400)

        /* cmbru (a tap on thumbs 31+34) leaves en for ru, and taps Caps Lock so the
           host follows. Everything below therefore resolves on ru. */
        ZMK_MOCK_PRESS(3,1,5)
        ZMK_MOCK_PRESS(3,4,20)
        ZMK_MOCK_RELEASE(3,1,10)
        ZMK_MOCK_RELEASE(3,4,300)

        /* "мо" rolled: о goes down and up while м (pos 23) is still held, and
           м is released inside the tapping term. Under the file's balanced
           &lt this would decide hold and lose both letters; tap-preferred
           must emit м then о. */
        ZMK_MOCK_PRESS(2,3,40)
        ZMK_MOCK_PRESS(1,6,40)
        ZMK_MOCK_RELEASE(1,6,40)
        ZMK_MOCK_RELEASE(2,3,300)

        /* "ть " — ь (pos 26) rolled into Space, the shape that ends most
           Russian words. The ь must survive. */
        ZMK_MOCK_PRESS(2,5,40)
        ZMK_MOCK_RELEASE(2,5,40)
        ZMK_MOCK_PRESS(2,6,40)
        ZMK_MOCK_PRESS(3,1,40)
        ZMK_MOCK_RELEASE(3,1,20)
        ZMK_MOCK_RELEASE(2,6,300)
    >;
};

#include "/cfg/op36_ruen.keymap"
