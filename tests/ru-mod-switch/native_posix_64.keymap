#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    chosen {
        zmk,matrix-transform = &transform;
    };

    /* op36 position N is RC(N/10, N%10); thumbs 30..35 are row 3. */
    transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };
};&kscan {
    rows = <4>;
    columns = <10>;
    events = <
        /* lead-in so require-prior-idle-ms sees real idle time */
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,400)

        /* cmbru leaves en for ru */
        ZMK_MOCK_PRESS(0,2,5)
        ZMK_MOCK_PRESS(0,3,30)
        ZMK_MOCK_RELEASE(0,2,10)
        ZMK_MOCK_RELEASE(0,3,300)

        /* Right Cmd (pos 16) with pos 4. Pos 4 is on the LEFT half, so the
           opposite-hand rule wants the right modifier. It must resolve on en
           and send 0x05 (B) — the whole point — not 0x17 (T, which is where
           ЙЦУКЕН puts е). */
        ZMK_MOCK_PRESS(1,6,350)
        ZMK_MOCK_PRESS(0,4,30)
        ZMK_MOCK_RELEASE(0,4,30)
        ZMK_MOCK_RELEASE(1,6,300)

        /* Released, ru must be back: pos 1 is й, 0x14. */
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,300)

        /* Right Shift (pos 18) deliberately does NOT switch, so pos 1 stays
           й (0x14) and not W (0x1A). This is what keeps capital Cyrillic. */
        ZMK_MOCK_PRESS(1,8,350)
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,30)
        ZMK_MOCK_RELEASE(1,8,300)

        /* Right Alt (pos 19) switches too. */
        ZMK_MOCK_PRESS(1,9,350)
        ZMK_MOCK_PRESS(0,4,30)
        ZMK_MOCK_RELEASE(0,4,30)
        ZMK_MOCK_RELEASE(1,9,300)

        /* Left Hyper (pos 2) with pos 8: en gives Y (0x1C), ru would give
           з (0x13). */
        ZMK_MOCK_PRESS(0,2,350)
        ZMK_MOCK_PRESS(0,8,30)
        ZMK_MOCK_RELEASE(0,8,30)
        ZMK_MOCK_RELEASE(0,2,300)

        /* And ru survived all of it. */
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,200)
    >;
};

#include "/cfg/op36_ruen.keymap"
