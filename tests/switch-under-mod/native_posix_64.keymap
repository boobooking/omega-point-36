#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    chosen {
        zmk,matrix-transform = &transform;
    };

    /* op36 position N is RC(N/10, N%10); thumbs 30..35 are row 3. */
    transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };
};

&kscan {
    rows = <4>;
    columns = <10>;
    events = <
        /* lead-in so require-prior-idle-ms sees real idle time */
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,400)

        /* position 32 leaves en for ru: one Globe. */
        ZMK_MOCK_PRESS(3,2,30)
        ZMK_MOCK_RELEASE(3,2,300)

        /* Hold right Cmd (pos 16), then press the switch key. It must do
           nothing at all: no switch, and ru still active at the end.

           Position 32 carries two jobs, hold for the symbol layer and tap to
           switch language, and under a modifier neither can be right. A copy of
           en's binding would run layer_ru — "go to ru" from ru — tapping Caps
           Lock without moving the firmware. A &trans would fall through to ru
           and reach sym_ru, whose symbols go through the &en wrapper and tap
           the layout too, under a held Cmd. So en_letters has &none there and the
           press is refused.

           The cost is that Cmd plus the left thumb no longer reaches a symbol
           layer. Enter on pos 33 still does, and still reaches sym_en with its
           Latin symbols, which is the one that matters for shortcuts. */
        ZMK_MOCK_PRESS(1,6,350)
        ZMK_MOCK_PRESS(3,2,30)
        ZMK_MOCK_RELEASE(3,2,200)
        ZMK_MOCK_RELEASE(1,6,300)

        /* Which layer did we end on? pos 1 is й (0x14) on ru, W (0x1A) on en. */
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,200)
    >;
};

#include "/cfg/op36_ruen.keymap"
