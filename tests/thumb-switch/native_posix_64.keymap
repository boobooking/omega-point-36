#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/kscan_mock.h>

/ {
    chosen {
        zmk,matrix-transform = &transform;
    };

    /* op36 position N is RC(N/10, N%10); thumbs 30..35 are row 3. */
    transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
        >;
    };
};

&kscan {
    rows = <4>;
    columns = <10>;
    events = <
        /* lead-in so require-prior-idle-ms sees real idle time */
        ZMK_MOCK_PRESS(0,1,10)
        ZMK_MOCK_RELEASE(0,1,400)

        /* cmbru: thumbs 31 and 34 tapped together leave en for ru and send one
           Globe, so pos 1 must read as й (0x14) rather than W (0x1A). */
        ZMK_MOCK_PRESS(3,1,5)
        ZMK_MOCK_PRESS(3,4,20)
        ZMK_MOCK_RELEASE(3,1,10)
        ZMK_MOCK_RELEASE(3,4,300)
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,300)

        /* cmben, the other direction: one more Globe, pos 1 is W again. */
        ZMK_MOCK_PRESS(3,1,5)
        ZMK_MOCK_PRESS(3,4,20)
        ZMK_MOCK_RELEASE(3,1,10)
        ZMK_MOCK_RELEASE(3,4,300)
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,300)

        /* Position 32 is the key the switch vacated. Tapped, it is Escape
           (0x29) and nothing else: no Globe, and pos 1 still reads W. */
        ZMK_MOCK_PRESS(3,2,30)
        ZMK_MOCK_RELEASE(3,2,300)
        ZMK_MOCK_PRESS(0,1,30)
        ZMK_MOCK_RELEASE(0,1,300)

        /* Tapped in sequence rather than together, the same two thumbs are
           still Space (0x2C) and Backspace (0x2A): outside timeout-ms the
           combo must not fire. */
        ZMK_MOCK_PRESS(3,1,50)
        ZMK_MOCK_RELEASE(3,1,200)
        ZMK_MOCK_PRESS(3,4,50)
        ZMK_MOCK_RELEASE(3,4,200)
    >;
};

#include "/cfg/op36_ruen.keymap"
