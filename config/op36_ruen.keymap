#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// keys_ru.h is generated for the Windows ЙЦУКЕН, which macOS calls
// "Русская — ПК". The host runs the Mac-traditional "Русская" instead. The two
// place every letter identically and disagree only on punctuation, which is why
// the ru layer types correctly while sym_ru did not. These are the keys where
// they differ; ё is the only letter among them. Each value was read out of the
// layout's own data with UCKeyTranslate, not off a chart.
//
// Base macros are redefined so their aliases follow: RU_DOT is (RU_PERIOD),
// RU_FSLH is (RU_SLASH), RU_SEMI is (RU_SEMICOLON), RU_QMARK is (RU_QUESTION),
// RU_PRCNT is (RU_PERCENT).
#undef RU_PERCENT
#define RU_PERCENT (LS(N4))
#undef RU_COLON
#define RU_COLON (LS(N5))
#undef RU_COMMA
#define RU_COMMA (LS(N6))
#undef RU_PERIOD
#define RU_PERIOD (LS(N7))
#undef RU_SEMICOLON
#define RU_SEMICOLON (LS(N8))
#undef RU_SLASH
#define RU_SLASH (FSLH)
#undef RU_QUESTION
#define RU_QUESTION (LS(FSLH))
#undef RU_CYRILLIC_IO
#define RU_CYRILLIC_IO (BSLH)

// The glyphs keys_ru.h has no macro for at all, plus * which it defines
// wrongly for this layout. "Русская" does carry every one of them — most under
// Option, which the earlier sweep missed by looking only at the plain and
// shifted states — so none of these needs the &en wrapper and its two Caps Lock
// taps. Read out of the layout's own data with UCKeyTranslate, dead-key
// processing left on; none of the ten is a dead key, and the identity of each
// physical key was confirmed against ABC rather than assumed:
//
//   {  Option+9          }  Option+0          *  Option+8
//   [  Shift+`           ]  `                 $  Option+4
//   '  Option+Shift+9    |  Option+Shift+1    ~  Option+M
//   `  Option+Shift+0
//
// Undef first: none of the nine exists in keys_ru.h today, and this way a
// future header that gains them cannot collide silently. RU_STAR is an alias
// of (RU_ASTERISK) and expands lazily, so redefining the base carries it.
#undef RU_LBRC
#define RU_LBRC (LA(N9))
#undef RU_RBRC
#define RU_RBRC (LA(N0))
#undef RU_LBKT
#define RU_LBKT (LS(GRAVE))
#undef RU_RBKT
#define RU_RBKT (GRAVE)
#undef RU_SQT
#define RU_SQT (LA(LS(N9)))
#undef RU_PIPE
#define RU_PIPE (LA(LS(N1)))
#undef RU_DLLR
#define RU_DLLR (LA(N4))
#undef RU_TILDE
#define RU_TILDE (LA(M))
#undef RU_GRAVE
#define RU_GRAVE (LA(LS(N0)))
#undef RU_ASTERISK
#define RU_ASTERISK (LA(N8))

// \ is the one that really is absent: its key carries ё on this layout, which
// is why RU_CYRILLIC_IO is BSLH above. It stays on the &en wrapper, and staying
// undefined keeps a future &kp RU_BSLH from compiling to a silently wrong glyph.
#undef RU_BACKSLASH

// Layer indices. A layer *is* its position in the keymap node — &mo, &lt and
// &to take a plain devicetree cell, and there is no phandle to a layer — so the
// number is unavoidable at the binding. Naming it here means a reordering is one
// edit in this block instead of a hunt for literals, and the node names below
// are kept in the same order so the two cannot disagree silently.
//
// CONFIG_ZMK_LAYOUT_RESYNC_ALT_LAYER in module/Kconfig is the one layer index
// this block cannot reach: Kconfig does not see these defines. It defaults to 1,
// which is L_RU, and has to be moved by hand if ru ever moves.
#define L_EN 0
#define L_RU 1
#define L_RU_EXT 2
#define L_SYM_EN 3
#define L_SYM_RU 4
#define L_NAV 5
#define L_NUM_EN 6
#define L_NUM_RU 7
#define L_ADJ 8
#define L_EN_LTR 9

// &lt keeps ZMK's own "tap-preferred": the layer waits for the tapping term and
// a roll always taps, which is what a layer hanging off a letter key needs. The
// only change is quick-tap-ms, so tap-then-hold repeats the letter instead of
// raising the layer. The thumbs want the opposite and use &ltt below.
&lt {
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // The thumbs, and only the thumbs, want the layer to win as soon as
        // another key is used: with "tap-preferred" a fast opposite-hand press
        // would beat the layer to it. Everything hanging off a letter key stays
        // on the stock &lt, where a roll always taps.
        ltt: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        // Position 32 carries both jobs: hold for the symbol layer, tap to
        // switch language. &ltt cannot express it — its tap binding is &kp and
        // the switch is a macro — so these are the same behavior with the tap
        // swapped, one per direction. The second parameter goes to that macro,
        // which takes none, so it is written 0 and ignored; the schema demands
        // two cells regardless, the same as `&hyl 0 F`.
        //
        // No quick-tap-ms here on purpose. Repeating a tapped key is what that
        // is for, and repeating a language switch is never wanted: tap then
        // hold would switch twice instead of raising the layer.
        //
        // Balanced like the other thumbs, and here it is also the safer
        // flavour: a roll resolves as a hold, so it yields the symbol layer
        // rather than an accidental language switch. Tap-preferred would do the
        // opposite.
        ltru: layer_tap_to_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&layer_ru>;
        };

        lten: layer_tap_to_en {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&layer_en>;
        };

        // Hyper on the top row. The hold binding has to be the &hyper macro, not
        // &kp LS(LC(LA(LGUI))): that form registers LGUI as an explicit modifier
        // but Shift/Ctrl/Alt only as implicit ones, and
        // hid_listener_keycode_pressed overwrites the implicit set on the very
        // next keypress, so the chord would reach the host as plain Cmd. Four
        // separate &kp modifiers all go through zmk_hid_register_mod and stick.
        // The 0 in `&hyl 0 F` is the hold parameter, unused because the macro
        // takes none; the hold-tap schema still demands two cells.
        hyl: hyper_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&hyper>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hyr: hyper_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&hyper>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // Same as hml/hmr, but the hold drops to en for its duration. Only used
        // on ru: the letters there are positional ЙЦУКЕН, so the physical key
        // carrying a given scancode differs from Colemak-DH and every shortcut
        // lands on the wrong one. Shift is deliberately left on plain hml/hmr —
        // it is what types capital Cyrillic, and switching would make it type
        // Latin instead.
        hml_ru: home_row_mod_left_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&en_mod>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr_ru: home_row_mod_right_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&en_mod>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // hmr_ru with the hold binding swapped for en_mod_prefix. Only position
        // 17 uses it, the right Ctrl, which is the modifier of the herdr prefix
        // and is used for nothing else. Flavour, guards and trigger list are
        // untouched, so the key behaves exactly like its neighbours otherwise.
        hmr_pfx: home_row_mod_right_prefix {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&en_mod_prefix>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // Holds en_letters over ru across exactly one key press. This is the
        // stock &sl in everything but two properties. ignore-modifiers, which
        // &sl does not carry and &sk does: without it the Shift of a
        // Shift+letter command would consume the sticky before the letter
        // arrived. And release-after-ms, which has to outlast the human, not
        // the keystroke — herdr puts a prompt on screen and you read it before
        // choosing a command. The stock 1000 expired first and the command key
        // arrived as Cyrillic, which is the whole bug this value fixes.
        //
        // herdr itself has no prefix timeout: ClientShellMode::Prefix in
        // src/client/shell/input.rs is a key-driven state machine with no timer,
        // and any key at all leaves the mode. So the firmware should hold until
        // the next key too, and 600000 is "long enough that it never decides
        // first". Any key press consumes the sticky, so the only cost is one
        // Latin character if you arm the prefix and then abandon it.
        //
        // It only works because en_letters sits above ru. Raising layer 0
        // itself is impossible — keymap.c pins the default layer at 0, keeps it
        // always active and makes it the floor of the lookup.
        sken: sticky_en {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <600000>;
            ignore-modifiers;
        };

        hyl_ru: hyper_left_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&hyper_en>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hyr_ru: hyper_right_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&hyper_en>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // Shift+digit is resolved by the host layout, and "Русская" does not
        // keep the English symbols there: Shift+2 is ", Shift+4 is % and
        // Shift+5 is :. It does carry all of them one row over, under Option —
        // @ # $ % ^ & * sit on Option+2 through Option+8 — so these seven reach
        // the English symbol directly, with no Caps Lock and no host switching.
        // Read out of the layout's own data with UCKeyTranslate, with dead-key
        // processing left on: none of the seven is a dead key.
        //
        // Only 2..8 need this. Shift+1, Shift+9 and Shift+0 already give ! ( )
        // on both layouts, so those three stay plain &kp on numbers_ru and the
        // drift check requires them to match numbers_en exactly.
        //
        // keep-mods is deliberately absent, so ZMK masks the Shift that chose
        // the morph and the host sees a clean Option+digit rather than
        // Shift+Option+digit (behavior_mod_morph.c: masked_mods = mods when the
        // property is missing).
        d2: digit_2_ru {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N2>, <&kp LA(N2)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        d3: digit_3_ru {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N3>, <&kp LA(N3)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        d4: digit_4_ru {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N4>, <&kp LA(N4)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        d5: digit_5_ru {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N5>, <&kp LA(N5)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        d6: digit_6_ru {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N6>, <&kp LA(N6)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        d7: digit_7_ru {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N7>, <&kp LA(N7)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        d8: digit_8_ru {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp N8>, <&kp LA(N8)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        // Ctrl+Space switches the input language, and it is the one binding
        // both target platforms honour: iPadOS treats it as the input-source
        // shortcut natively, and macOS exposes it under Settings → Keyboard →
        // Keyboard Shortcuts → Input Sources. **On macOS it has to be enabled
        // there** — the default arrives switched off, which is why pressing
        // Ctrl+Space on this host changed nothing before. It selects the
        // *previous* source, so with exactly two layouts it toggles, and
        // callers must only invoke it when leaving the layer they are on.
        //
        // GLOBE was tried here and macOS ignores it. That is not a descriptor
        // problem: the report descriptor read back off the connected keyboard
        // advertises the consumer page with Usage Max 0xFFF over a 16-bit
        // field, so 0x29D fits and macOS parses the collection. Apple's
        // "Press 🌐 key to" simply does not answer to the consumer usage from a
        // third-party keyboard. iPadOS did honour it. Do not spend another
        // firmware on GLOBE without new evidence about macOS specifically.
        //
        // Caps Lock is the other thing that used to be here, and it is worse
        // than both: macOS applies CapsLockDelay, 75 ms on this host, and a tap
        // under that threshold is dropped silently, moving the firmware's layer
        // while the host stays put. A plain modifier chord has no threshold at
        // all, which is the whole reason to prefer it, and no tap-ms is needed.
        //
        // This chord was herdr's prefix until it moved to Ctrl+B to free it.
        // One consequence worth knowing: pressing the right Ctrl and Space by
        // hand now switches the host without moving the firmware layer, which
        // is a desync. Nothing sends it but this macro, so it takes an accident.
        os_lang: os_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "OS_LANG";
            wait-ms = <0>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_EN &os_lang>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to L_RU &os_lang>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&os_lang>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&os_lang>;

            label = "EN";
            wait-ms = <50>;
            tap-ms = <30>;
        };

        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>,
                <&macro_pause_for_release>,
                <&macro_release &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>;

            label = "HYPER";
            wait-ms = <0>;
        };

        // Hold a modifier with the English letters under it, by raising
        // en_letters over ru rather than switching ru off. The layer unwinds
        // with the key, so the base never stops being ru and nothing has to be
        // put back afterwards.
        en_mod: en_mod {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo L_EN_LTR>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&mo L_EN_LTR>;

            label = "EN_MOD";
            wait-ms = <0>;
        };

        // en_mod, except that letting the modifier go arms sken instead of
        // dropping en_letters, so the key pressed after the chord still
        // resolves on en. That is the whole herdr prefix fix: releasing Ctrl is
        // the only moment between "Ctrl+Space has been sent" and "the command
        // key is pressed".
        //
        // It cannot tell which key was pressed during the hold, so it arms after
        // any chord made with this modifier. That costs nothing because the
        // right Ctrl is only ever the prefix.
        en_mod_prefix: en_mod_prefix {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo L_EN_LTR>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&mo L_EN_LTR>,
                <&macro_tap>,
                <&sken L_EN_LTR>;

            label = "EN_MOD_PREFIX";
            wait-ms = <0>;
        };

        hyper_en: hyper_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &mo L_EN_LTR &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>,
                <&macro_pause_for_release>,
                <&macro_release &kp LCTRL &kp LSHFT &kp LALT &kp LGUI &mo L_EN_LTR>;

            label = "HYPER_EN";
            wait-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
  &none        &kp W         &hyl 0 F      &kp P        &kp B                                                         &kp Z                 &kp L          &hyr 0 U      &kp Y         &none
  &hml LALT A  &hml LSHFT R  &hml LCTRL S  &hml LGUI T  &kp G                                                         &kp M                 &hmr RGUI N    &hmr RCTRL E  &hmr RSHFT I  &hmr LALT O
  &none        &kp X         &kp C         &kp D        &kp V                                                         &kp K                 &kp H          &kp J         &kp Q         &none
                                           &kp ESC      &ltt L_NUM_EN SPACE  &ltru L_SYM_EN 0    &ltt L_SYM_EN ENTER  &ltt L_NAV BACKSPACE  &lt L_ADJ TAB
            >;

            display-name = "Base";
        };

        ru {
            bindings = <
  &none                        &kp RU_CYRILLIC_SHORT_I      &hyl_ru 0 RU_CYRILLIC_U       &kp RU_CYRILLIC_KA           &kp RU_CYRILLIC_IE                                            &kp RU_CYRILLIC_EN    &kp RU_CYRILLIC_GHE                 &hyr_ru 0 RU_CYRILLIC_SHA      &kp RU_CYRILLIC_ZE         &none
  &hml_ru LALT RU_CYRILLIC_YA  &hml LSHFT RU_CYRILLIC_YERU  &hml_ru LCTRL RU_CYRILLIC_VE  &hml_ru LGUI RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                                            &kp RU_CYRILLIC_ER    &hmr_ru RGUI RU_CYRILLIC_O          &hmr_pfx RCTRL RU_CYRILLIC_EL  &hmr RSHFT RU_CYRILLIC_DE  &hmr_ru LALT RU_CYRILLIC_ZHE
  &none                        &kp RU_CYRILLIC_CHE          &kp RU_CYRILLIC_ES            &lt L_RU_EXT RU_CYRILLIC_EM  &kp RU_CYRILLIC_I                                             &kp RU_CYRILLIC_TE    &lt L_RU_EXT RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE             &kp RU_CYRILLIC_YU         &none
                                                                                          &kp ESC                      &ltt L_NUM_RU SPACE  &lten L_SYM_RU 0    &ltt L_SYM_RU ENTER  &ltt L_NAV BACKSPACE  &lt L_ADJ TAB
            >;

            display-name = "Ru";
        };

        ru_ext {
            bindings = <
  &none               &kp RU_CYRILLIC_TSE  &none  &none   &kp RU_CYRILLIC_IO                    &none   &none                      &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_E   &none
  &kp RU_CYRILLIC_EF  &none                &none  &none   &none                                 &none   &none                      &none                  &kp RU_CYRILLIC_HA  &none
  &none               &none                &none  &none   &none                                 &none   &kp RU_CYRILLIC_HARD_SIGN  &none                  &none               &none
                                                  &trans  &trans              &trans    &trans  &trans  &trans
            >;

            display-name = "Ru ext";
        };

        sym_en {
            bindings = <
  &none     &kp LPAR          &kp LBRC   &kp RPAR        &kp PIPE                    &kp QMARK  &kp LBKT   &kp PLUS   &kp RBKT  &none
  &kp STAR  &hml LSHFT UNDER  &kp RBRC   &hml LGUI DLLR  &none                       &kp FSLH   &kp SQT    &kp MINUS  &kp DQT   &kp EQUAL
  &none     &kp TILDE         &kp GRAVE  &kp COLON       &kp SEMI                    &kp PRCNT  &kp COMMA  &kp DOT    &kp BSLH  &none
                                         &trans          &trans    &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            bindings = <
  &none        &kp RU_LPAR          &kp RU_LBRC   &kp RU_RPAR        &kp RU_PIPE                    &kp RU_QMARK  &kp RU_LBKT   &kp RU_PLUS   &kp RU_RBKT  &none
  &kp RU_STAR  &hml LSHFT RU_UNDER  &kp RU_RBRC   &hml LGUI RU_DLLR  &none                          &kp RU_FSLH   &kp RU_SQT    &kp RU_MINUS  &kp RU_DQT   &kp RU_EQUAL
  &none        &kp RU_TILDE         &kp RU_GRAVE  &kp RU_COLON       &kp RU_SEMI                    &kp RU_PRCNT  &kp RU_COMMA  &kp RU_DOT    &en BSLH     &none
                                                  &trans             &trans       &trans    &trans  &trans        &trans
            >;

            display-name = "Symbols";
        };

        nav {
            bindings = <
  &none  &kp LG(LS(LBKT))  &kp UP    &kp LG(LS(RBKT))  &none                     &none   &to L_EN  &to L_RU   &none      &none
  &none  &kp LEFT          &kp DOWN  &kp RIGHT         &none                     &none   &kp RGUI  &kp RCTRL  &kp RSHFT  &kp LALT
  &none  &none             &none     &none             &none                     &none   &none     &none      &none      &none
                                     &trans            &trans  &trans    &trans  &trans  &trans
            >;

            display-name = "Nav";
        };

        numbers_en {
            bindings = <
  &none     &kp LA(LC(LG(LS(N2))))  &kp LG(TAB)  &kp LC(LG(LS(FSLH)))  &kp LA(LC(LG(LS(N1))))                    &none   &kp N7  &kp N8  &kp N9  &none
  &kp LALT  &kp LSHFT               &kp LCTRL    &kp LGUI              &none                                     &none   &kp N4  &kp N5  &kp N6  &none
  &none     &none                   &none        &none                 &none                                     &kp N0  &kp N1  &kp N2  &kp N3  &none
                                                 &trans                &trans                  &trans    &trans  &trans  &trans
            >;

            display-name = "Numbers";
        };

        numbers_ru {
            bindings = <
  &none     &kp LA(LC(LG(LS(N2))))  &kp LG(TAB)  &kp LC(LG(LS(FSLH)))  &kp LA(LC(LG(LS(N1))))                    &none   &d7     &d8  &kp N9  &none
  &kp LALT  &kp LSHFT               &kp LCTRL    &kp LGUI              &none                                     &none   &d4     &d5  &d6     &none
  &none     &none                   &none        &none                 &none                                     &kp N0  &kp N1  &d2  &d3     &none
                                                 &trans                &trans                  &trans    &trans  &trans  &trans
            >;

            display-name = "Numbers";
        };

        adj {
            bindings = <
  &none        &none  &none  &none   &none                     &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none
  &bootloader  &none  &none  &none   &none                     &none   &out OUT_BLE  &out OUT_USB  &none         &studio_unlock
  &none        &none  &none  &none   &none                     &none   &none         &bt BT_CLR    &none         &none
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;

            display-name = "Adjust";
        };

        en_letters {
            bindings = <
  &none        &kp W         &hyl 0 F      &kp P        &kp B                                              &kp Z                 &kp L          &hyr 0 U      &kp Y         &none
  &hml LALT A  &hml LSHFT R  &hml LCTRL S  &hml LGUI T  &kp G                                              &kp M                 &hmr RGUI N    &hmr RCTRL E  &hmr RSHFT I  &hmr LALT O
  &none        &kp X         &kp C         &kp D        &kp V                                              &kp K                 &kp H          &kp J         &kp Q         &none
                                           &kp ESC      &ltt L_NUM_EN SPACE  &none    &ltt L_SYM_EN ENTER  &ltt L_NAV BACKSPACE  &lt L_ADJ TAB
            >;

            display-name = "En letters";
        };
    };
};
