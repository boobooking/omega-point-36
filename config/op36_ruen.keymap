#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

// The stock "tap-preferred" flavor only reaches the layer after the tapping
// term expires, which would make the layer lag behind a fast opposite-hand
// press. "balanced" lets the layer win as soon as another key is used, while
// quick-tap-ms keeps tap-then-hold repeating the tapped key.
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // Same as hml, but taps through the en macro. Needed on the Cyrillic
        // symbol layer for glyphs that only exist on the Latin layout and so
        // cannot be reached with a plain &kp.
        hml_en: home_row_mod_left_en {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&en>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        // ru_ext hangs off two letter keys, so it must NOT use this file's &lt.
        // That one is "balanced", which decides hold as soon as the next key is
        // released — a roll through м or ь ("мо", "быть ") would raise the layer
        // and swallow the letter. Only the timer raises this one. There is no
        // require-prior-idle-ms for the same reason the kha/hrdsgn combos never
        // had one: х and ъ are wanted mid-word.
        lt_ext: layer_tap_ru_ext {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        // Hyper on the top row. The hold binding has to be the &hyper macro, not
        // &kp LS(LC(LA(LGUI))): that form registers LGUI as an explicit modifier
        // but Shift/Ctrl/Alt only as implicit ones, and
        // hid_listener_keycode_pressed overwrites the implicit set on the very
        // next keypress, so the chord would reach the host as plain Cmd. Four
        // separate &kp modifiers all go through zmk_hid_register_mod and stick.
        // The 0 in `&hyl 0 F` is the hold parameter, unused because the macro
        // takes none; the hold-tap schema still demands two cells.
        hyl: hyper_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&hyper>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hyr: hyper_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&hyper>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // Same as hml/hmr, but the hold drops to en for its duration. Only used
        // on ru: the letters there are positional ЙЦУКЕН, so the physical key
        // carrying a given scancode differs from Colemak-DH and every shortcut
        // lands on the wrong one. Shift is deliberately left on plain hml/hmr —
        // it is what types capital Cyrillic, and switching would make it type
        // Latin instead.
        hml_ru: home_row_mod_left_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&en_mod>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr_ru: home_row_mod_right_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&en_mod>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        hyl_ru: hyper_left_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&hyper_en>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hyr_ru: hyper_right_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&hyper_en>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        cmben {
            bindings = <&layer_en>;
            key-positions = <2 3>;
            layers = <1>;
            require-prior-idle-ms = <150>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <2 3>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
    };

    macros {
        // Caps Lock switches the input language on macOS and iPadOS. It toggles
        // between the two layouts, so callers must only invoke it when leaving
        // the layer they are currently on.
        os_lang: os_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPS>;
            label = "OS_LANG";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &os_lang>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &os_lang>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&os_lang>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&os_lang>;

            label = "EN";
            wait-ms = <50>;
            tap-ms = <30>;
        };

        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>,
                <&macro_pause_for_release>,
                <&macro_release &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>;

            label = "HYPER";
            wait-ms = <0>;
        };

        // Hold a modifier with en underneath it. &to does not touch flash — the
        // settings_save_one calls in keymap.c are all Studio keymap edits — so
        // paying it on every modifier press is free. &to 1 on the way out is
        // absolute rather than a toggle, so the layer is right however the hold
        // ended.
        en_mod: en_mod {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to 0>,
                <&macro_press>,
                <&mo 8>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&mo 8>,
                <&macro_tap>,
                <&to 1>;

            label = "EN_MOD";
            wait-ms = <0>;
        };

        hyper_en: hyper_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&to 0>,
                <&macro_press &mo 8 &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>,
                <&macro_pause_for_release>,
                <&macro_release &kp LCTRL &kp LSHFT &kp LALT &kp LGUI &mo 8>,
                <&macro_tap>,
                <&to 1>;

            label = "HYPER_EN";
            wait-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
  &none        &kp W         &hyl 0 F      &kp P        &kp B                                  &kp Z            &kp L        &hyr 0 U      &kp Y         &none
  &hml LALT A  &hml LSHFT R  &hml LCTRL S  &hml LGUI T  &kp G                                  &kp M            &hmr RGUI N  &hmr RCTRL E  &hmr RSHFT I  &hmr LALT O
  &none        &kp X         &kp C         &kp D        &kp V                                  &kp K            &kp H        &kp J         &kp Q         &none
                                           &none        &lt 6 SPACE  &lt 3 ESC    &lt 3 ENTER  &lt 5 BACKSPACE  &none
            >;

            display-name = "Base";
        };

        ru {
            bindings = <
  &none                        &kp RU_CYRILLIC_SHORT_I      &hyl_ru 0 RU_CYRILLIC_U       &kp RU_CYRILLIC_KA          &kp RU_CYRILLIC_IE                            &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE              &hyr_ru 0 RU_CYRILLIC_SHA     &kp RU_CYRILLIC_ZE         &none
  &hml_ru LALT RU_CYRILLIC_YA  &hml LSHFT RU_CYRILLIC_YERU  &hml_ru LCTRL RU_CYRILLIC_VE  &hml_ru LGUI RU_CYRILLIC_A  &kp RU_CYRILLIC_PE                            &kp RU_CYRILLIC_ER  &hmr_ru RGUI RU_CYRILLIC_O       &hmr_ru RCTRL RU_CYRILLIC_EL  &hmr RSHFT RU_CYRILLIC_DE  &hmr_ru LALT RU_CYRILLIC_ZHE
  &none                        &kp RU_CYRILLIC_CHE          &kp RU_CYRILLIC_ES            &lt_ext 2 RU_CYRILLIC_EM    &kp RU_CYRILLIC_I                             &kp RU_CYRILLIC_TE  &lt_ext 2 RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE            &kp RU_CYRILLIC_YU         &none
                                                                                          &none                       &lt 6 SPACE         &lt 4 ESC    &lt 4 ENTER  &lt 5 BACKSPACE     &none
            >;

            display-name = "Ru";
        };

        ru_ext {
            bindings = <
  &none               &kp RU_CYRILLIC_TSE  &none  &none   &kp RU_CYRILLIC_IO                    &none   &none                      &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_E  &none
  &kp RU_CYRILLIC_EF  &none                &none  &none   &none                                 &none   &none                      &kp RU_CYRILLIC_HA     &none              &none
  &none               &none                &none  &none   &none                                 &none   &kp RU_CYRILLIC_HARD_SIGN  &none                  &none              &none
                                                  &trans  &trans              &trans    &trans  &trans  &trans
            >;

            display-name = "Ru ext";
        };

        sym_en {
            bindings = <
  &none     &kp LPAR          &kp LBRC   &kp RPAR        &kp PIPE                    &kp QMARK  &kp LBKT   &kp PLUS   &kp RBKT  &none
  &kp STAR  &hml LSHFT UNDER  &kp RBRC   &hml LGUI DLLR  &none                       &kp FSLH   &kp SQT    &kp MINUS  &kp DQT   &kp EQUAL
  &none     &kp TILDE         &kp GRAVE  &kp COLON       &kp SEMI                    &kp PRCNT  &kp COMMA  &kp DOT    &kp BSLH  &none
                                         &trans          &trans    &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            bindings = <
  &none        &kp RU_LPAR          &en LBRC   &kp RU_RPAR        &en PIPE                       &kp RU_QMARK  &en LBKT      &kp RU_PLUS   &en RBKT     &none
  &kp RU_STAR  &hml LSHFT RU_UNDER  &en RBRC   &hml_en LGUI DLLR  &none                          &kp RU_FSLH   &en SQT       &kp RU_MINUS  &kp RU_DQT   &kp RU_EQUAL
  &none        &en TILDE            &en GRAVE  &kp RU_COLON       &kp RU_SEMI                    &kp RU_PRCNT  &kp RU_COMMA  &kp RU_DOT    &kp RU_BSLH  &none
                                               &trans             &trans       &trans    &trans  &trans        &trans
            >;

            display-name = "Symbols";
        };

        nav {
            bindings = <
  &none  &kp LG(LS(LBKT))  &kp UP    &kp LG(LS(RBKT))  &none                          &none   &to 0     &to 1      &none      &none
  &none  &kp LEFT          &kp DOWN  &kp RIGHT         &kp TAB                        &none   &kp RGUI  &kp RCTRL  &kp RSHFT  &kp LALT
  &none  &none             &none     &none             &none                          &none   &none     &none      &none      &none
                                     &trans            &lt 7 SPACE  &trans    &trans  &trans  &trans
            >;

            display-name = "Nav";
        };

        numbers {
            bindings = <
  &none     &kp LA(LC(LG(LS(N2))))  &kp LG(TAB)  &kp LC(LG(LS(FSLH)))  &kp LA(LC(LG(LS(N1))))                    &none            &kp N7  &kp N8  &kp N9  &none
  &kp LALT  &kp LSHFT               &kp LCTRL    &kp LGUI              &none                                     &none            &kp N4  &kp N5  &kp N6  &none
  &none     &none                   &none        &none                 &none                                     &kp N0           &kp N1  &kp N2  &kp N3  &none
                                                 &trans                &trans                  &trans    &trans  &lt 7 BACKSPACE  &trans
            >;

            display-name = "Numbers";
        };

        adj {
            bindings = <
  &none        &none  &none  &none   &none                     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none
  &bootloader  &none  &none  &none   &none                     &out OUT_BLE  &bt BT_CLR    &none         &none         &studio_unlock
  &none        &none  &none  &none   &none                     &out OUT_USB  &none         &none         &none         &none
                             &trans  &trans  &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };

        en_hold {
            bindings = <
  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
                          &trans  &trans  &trans    &trans  &trans  &trans
            >;

            display-name = "En hold";
        };
    };
};
