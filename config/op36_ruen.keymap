#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

// The stock "tap-preferred" flavor only reaches the layer after the tapping
// term expires, which would make the layer lag behind a fast opposite-hand
// press. "balanced" lets the layer win as soon as another key is used, while
// quick-tap-ms keeps tap-then-hold repeating the tapped key.
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // Same as hml, but taps through the en macro. Needed on the Cyrillic
        // symbol layer for glyphs that only exist on the Latin layout and so
        // cannot be reached with a plain &kp.
        hml_en: home_row_mod_left_en {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&en>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        kha {
            bindings = <&kp RU_CYRILLIC_HA>;
            key-positions = <6 7>;
            layers = <1>;
        };

        hrdsgn {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <7 8>;
            layers = <1>;
        };

        cmben {
            bindings = <&layer_en>;
            key-positions = <2 3>;
            layers = <1>;
            require-prior-idle-ms = <150>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <2 3>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
    };

    macros {
        // Caps Lock switches the input language on macOS and iPadOS. It toggles
        // between the two layouts, so callers must only invoke it when leaving
        // the layer they are currently on.
        os_lang: os_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPS>;
            label = "OS_LANG";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &os_lang>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &os_lang>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&os_lang>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&os_lang>;

            label = "EN";
            wait-ms = <50>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
  &kp Q        &kp W         &kp E         &kp R        &kp T                                  &kp Y            &kp U        &kp I         &kp O         &kp P
  &hml LALT A  &hml LSHFT S  &hml LCTRL D  &hml LGUI F  &kp G                                  &kp H            &hmr RGUI J  &hmr RCTRL K  &hmr RSHFT L  &hmr LALT SEMICOLON
  &kp Z        &kp X         &kp C         &kp V        &kp B                                  &kp N            &kp M        &kp COMMA     &kp DOT       &kp SQT
                                           &none        &lt 4 SPACE  &lt 2 ESC    &lt 2 ENTER  &lt 4 BACKSPACE  &none
            >;

            display-name = "Base";
        };

        ru {
            bindings = <
  &kp RU_CYRILLIC_SHORT_I   &kp RU_CYRILLIC_TSE          &kp RU_CYRILLIC_U          &kp RU_CYRILLIC_KA       &kp RU_CYRILLIC_IE                            &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA        &kp RU_CYRILLIC_SHCHA      &kp RU_CYRILLIC_ZE
  &hml LALT RU_CYRILLIC_EF  &hml LSHFT RU_CYRILLIC_YERU  &hml LCTRL RU_CYRILLIC_VE  &hml LGUI RU_CYRILLIC_A  &kp RU_CYRILLIC_PE                            &kp RU_CYRILLIC_ER  &hmr RGUI RU_CYRILLIC_O    &hmr RCTRL RU_CYRILLIC_EL  &hmr RSHFT RU_CYRILLIC_DE  &hmr LALT RU_CYRILLIC_ZHE
  &kp RU_CYRILLIC_YA        &kp RU_CYRILLIC_CHE          &kp RU_CYRILLIC_ES         &kp RU_CYRILLIC_EM       &kp RU_CYRILLIC_I                             &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE         &kp RU_CYRILLIC_YU         &kp RU_CYRILLIC_E
                                                                                    &none                    &lt 4 SPACE         &lt 3 ESC    &lt 3 ENTER  &lt 4 BACKSPACE     &none
            >;

            display-name = "Ru";
        };

        sym_en {
            bindings = <
  &none     &kp LPAR          &kp LBRC   &kp RPAR        &kp PIPE                       &kp QMARK  &kp LBKT   &kp PLUS   &kp RBKT  &none
  &kp STAR  &hml LSHFT UNDER  &kp RBRC   &hml LGUI DLLR  &none                          &kp FSLH   &kp SQT    &kp MINUS  &kp DQT   &kp EQUAL
  &none     &kp TILDE         &kp GRAVE  &kp COLON       &kp SEMI                       &kp PRCNT  &kp COMMA  &kp DOT    &kp BSLH  &none
                                         &trans          &lt 5 SPACE  &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            bindings = <
  &none        &kp RU_LPAR          &en LBRC   &kp RU_RPAR        &en PIPE                       &kp RU_QMARK  &en LBKT      &kp RU_PLUS   &en RBKT     &none
  &kp RU_STAR  &hml LSHFT RU_UNDER  &en RBRC   &hml_en LGUI DLLR  &none                          &kp RU_FSLH   &en SQT       &kp RU_MINUS  &kp RU_DQT   &kp RU_EQUAL
  &none        &en TILDE            &en GRAVE  &kp RU_COLON       &kp RU_SEMI                    &kp RU_PRCNT  &kp RU_COMMA  &kp RU_DOT    &kp RU_BSLH  &none
                                               &trans             &lt 5 SPACE  &trans    &trans  &trans        &trans
            >;

            display-name = "Symbols";
        };

        nav {
            bindings = <
  &none  &kp LG(LS(LBKT))  &kp UP    &kp LG(LS(RBKT))  &none                      &none            &to 0     &to 1      &none      &none
  &none  &kp LEFT          &kp DOWN  &kp RIGHT         &kp TAB                    &none            &kp RGUI  &kp RCTRL  &kp RSHFT  &kp LALT
  &none  &none             &none     &none             &none                      &none            &none     &none      &none      &none
                                     &trans            &trans   &trans    &trans  &lt 5 BACKSPACE  &trans
            >;

            display-name = "Nav";
        };

        adj {
            bindings = <
  &none        &none  &none  &none   &none                     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &none
  &bootloader  &none  &none  &none   &none                     &out OUT_BLE  &bt BT_CLR    &none         &none         &studio_unlock
  &none        &none  &none  &none   &none                     &out OUT_USB  &none         &none         &none         &none
                             &trans  &trans  &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };
    };
};
