#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// keys_ru.h is generated for the Windows ЙЦУКЕН, which macOS calls
// "Русская — ПК". The host runs the Mac-traditional "Русская" instead. The two
// place every letter identically and disagree only on punctuation, which is why
// the ru layer types correctly while sym_ru did not. These are the keys where
// they differ; ё is the only letter among them. Each value was read out of the
// layout's own data with UCKeyTranslate, not off a chart.
//
// Base macros are redefined so their aliases follow: RU_DOT is (RU_PERIOD),
// RU_FSLH is (RU_SLASH), RU_SEMI is (RU_SEMICOLON), RU_QMARK is (RU_QUESTION),
// RU_PRCNT is (RU_PERCENT).
#undef RU_PERCENT
#define RU_PERCENT (LS(N4))
#undef RU_COLON
#define RU_COLON (LS(N5))
#undef RU_COMMA
#define RU_COMMA (LS(N6))
#undef RU_PERIOD
#define RU_PERIOD (LS(N7))
#undef RU_SEMICOLON
#define RU_SEMICOLON (LS(N8))
#undef RU_SLASH
#define RU_SLASH (FSLH)
#undef RU_QUESTION
#define RU_QUESTION (LS(FSLH))
#undef RU_CYRILLIC_IO
#define RU_CYRILLIC_IO (BSLH)

// "Русская" has no key for * or \ at all — a full sweep of every plain and
// shifted keycode finds * only on the numeric keypad and \ nowhere. Both go
// through the &en wrapper on sym_ru instead. Undefining them keeps a future
// &kp RU_STAR from compiling to a silently wrong glyph.
#undef RU_ASTERISK
#undef RU_BACKSLASH

// &lt keeps ZMK's own "tap-preferred": the layer waits for the tapping term and
// a roll always taps, which is what a layer hanging off a letter key needs. The
// only change is quick-tap-ms, so tap-then-hold repeats the letter instead of
// raising the layer. The thumbs want the opposite and use &ltt below.
&lt {
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // Same as hml, but taps through the en macro. Needed on the Cyrillic
        // symbol layer for glyphs that only exist on the Latin layout and so
        // cannot be reached with a plain &kp.
        hml_en: home_row_mod_left_en {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&en>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        // The thumbs, and only the thumbs, want the layer to win as soon as
        // another key is used: with "tap-preferred" a fast opposite-hand press
        // would beat the layer to it. Everything hanging off a letter key stays
        // on the stock &lt, where a roll always taps.
        ltt: layer_tap_thumb {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        // Hyper on the top row. The hold binding has to be the &hyper macro, not
        // &kp LS(LC(LA(LGUI))): that form registers LGUI as an explicit modifier
        // but Shift/Ctrl/Alt only as implicit ones, and
        // hid_listener_keycode_pressed overwrites the implicit set on the very
        // next keypress, so the chord would reach the host as plain Cmd. Four
        // separate &kp modifiers all go through zmk_hid_register_mod and stick.
        // The 0 in `&hyl 0 F` is the hold parameter, unused because the macro
        // takes none; the hold-tap schema still demands two cells.
        hyl: hyper_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&hyper>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hyr: hyper_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&hyper>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // Same as hml/hmr, but the hold drops to en for its duration. Only used
        // on ru: the letters there are positional ЙЦУКЕН, so the physical key
        // carrying a given scancode differs from Colemak-DH and every shortcut
        // lands on the wrong one. Shift is deliberately left on plain hml/hmr —
        // it is what types capital Cyrillic, and switching would make it type
        // Latin instead.
        hml_ru: home_row_mod_left_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&en_mod>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr_ru: home_row_mod_right_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&en_mod>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // hmr_ru with the hold binding swapped for en_mod_prefix. Only position
        // 17 uses it, the right Ctrl, which is the modifier of the herdr prefix
        // and is used for nothing else. Flavour, guards and trigger list are
        // untouched, so the key behaves exactly like its neighbours otherwise.
        hmr_pfx: home_row_mod_right_prefix {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&en_mod_prefix>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };

        // Holds en_letters over ru across exactly one key press. This is the
        // stock &sl in everything but two properties. ignore-modifiers, which
        // &sl does not carry and &sk does: without it the Shift of a
        // Shift+letter command would consume the sticky before the letter
        // arrived. And release-after-ms, which has to outlast the human, not
        // the keystroke — herdr puts a prompt on screen and you read it before
        // choosing a command. The stock 1000 expired first and the command key
        // arrived as Cyrillic, which is the whole bug this value fixes. Any key
        // press consumes the sticky, so a long window only costs one Latin
        // character if you arm the prefix and then abandon it.
        //
        // It only works because en_letters sits above ru. Raising layer 0
        // itself is impossible — keymap.c pins the default layer at 0, keeps it
        // always active and makes it the floor of the lookup.
        sken: sticky_en {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <30000>;
            ignore-modifiers;
        };

        hyl_ru: hyper_left_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&hyper_en>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hyr_ru: hyper_right_ru {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&hyper_en>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
    };

    macros {
        // Caps Lock switches the input language on macOS and iPadOS. It toggles
        // between the two layouts, so callers must only invoke it when leaving
        // the layer they are currently on.
        os_lang: os_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPS>;
            label = "OS_LANG";
            wait-ms = <0>;
            tap-ms = <100>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &os_lang>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &os_lang>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&os_lang>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&os_lang>;

            label = "EN";
            wait-ms = <50>;
            tap-ms = <30>;
        };

        hyper: hyper {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>,
                <&macro_pause_for_release>,
                <&macro_release &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>;

            label = "HYPER";
            wait-ms = <0>;
        };

        // Hold a modifier with the English letters under it, by raising
        // en_letters over ru rather than switching ru off. The layer unwinds
        // with the key, so the base never stops being ru and nothing has to be
        // put back afterwards.
        en_mod: en_mod {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo 8>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&mo 8>;

            label = "EN_MOD";
            wait-ms = <0>;
        };

        // en_mod, except that letting the modifier go arms sken instead of
        // dropping en_letters, so the key pressed after the chord still
        // resolves on en. That is the whole herdr prefix fix: releasing Ctrl is
        // the only moment between "Ctrl+Space has been sent" and "the command
        // key is pressed".
        //
        // It cannot tell which key was pressed during the hold, so it arms after
        // any chord made with this modifier. That costs nothing because the
        // right Ctrl is only ever the prefix.
        en_mod_prefix: en_mod_prefix {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&mo 8>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&mo 8>,
                <&macro_tap>,
                <&sken 8>;

            label = "EN_MOD_PREFIX";
            wait-ms = <0>;
        };

        hyper_en: hyper_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press &mo 8 &kp LCTRL &kp LSHFT &kp LALT &kp LGUI>,
                <&macro_pause_for_release>,
                <&macro_release &kp LCTRL &kp LSHFT &kp LALT &kp LGUI &mo 8>;

            label = "HYPER_EN";
            wait-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
  &none        &kp W         &hyl 0 F      &kp P        &kp B                                     &kp Z             &kp L        &hyr 0 U      &kp Y         &none
  &hml LALT A  &hml LSHFT R  &hml LCTRL S  &hml LGUI T  &kp G                                     &kp M             &hmr RGUI N  &hmr RCTRL E  &hmr RSHFT I  &hmr LALT O
  &none        &kp X         &kp C         &kp D        &kp V                                     &kp K             &kp H        &kp J         &kp Q         &none
                                           &layer_ru    &ltt 6 SPACE  &ltt 3 ESC    &ltt 3 ENTER  &ltt 5 BACKSPACE  &mo 7
            >;

            display-name = "Base";
        };

        ru {
            bindings = <
  &none                        &kp RU_CYRILLIC_SHORT_I      &hyl_ru 0 RU_CYRILLIC_U       &kp RU_CYRILLIC_KA          &kp RU_CYRILLIC_IE                              &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE          &hyr_ru 0 RU_CYRILLIC_SHA      &kp RU_CYRILLIC_ZE         &none
  &hml_ru LALT RU_CYRILLIC_YA  &hml LSHFT RU_CYRILLIC_YERU  &hml_ru LCTRL RU_CYRILLIC_VE  &hml_ru LGUI RU_CYRILLIC_A  &kp RU_CYRILLIC_PE                              &kp RU_CYRILLIC_ER  &hmr_ru RGUI RU_CYRILLIC_O   &hmr_pfx RCTRL RU_CYRILLIC_EL  &hmr RSHFT RU_CYRILLIC_DE  &hmr_ru LALT RU_CYRILLIC_ZHE
  &none                        &kp RU_CYRILLIC_CHE          &kp RU_CYRILLIC_ES            &lt 2 RU_CYRILLIC_EM        &kp RU_CYRILLIC_I                               &kp RU_CYRILLIC_TE  &lt 2 RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE             &kp RU_CYRILLIC_YU         &none
                                                                                          &layer_en                   &ltt 6 SPACE        &ltt 4 ESC    &ltt 4 ENTER  &ltt 5 BACKSPACE    &mo 7
            >;

            display-name = "Ru";
        };

        ru_ext {
            bindings = <
  &none               &kp RU_CYRILLIC_TSE  &none  &none   &kp RU_CYRILLIC_IO                    &none   &none                      &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_E   &none
  &kp RU_CYRILLIC_EF  &none                &none  &none   &none                                 &none   &none                      &none                  &kp RU_CYRILLIC_HA  &none
  &none               &none                &none  &none   &none                                 &none   &kp RU_CYRILLIC_HARD_SIGN  &none                  &none               &none
                                                  &trans  &trans              &trans    &trans  &trans  &trans
            >;

            display-name = "Ru ext";
        };

        sym_en {
            bindings = <
  &none     &kp LPAR          &kp LBRC   &kp RPAR        &kp PIPE                    &kp QMARK  &kp LBKT   &kp PLUS   &kp RBKT  &none
  &kp STAR  &hml LSHFT UNDER  &kp RBRC   &hml LGUI DLLR  &none                       &kp FSLH   &kp SQT    &kp MINUS  &kp DQT   &kp EQUAL
  &none     &kp TILDE         &kp GRAVE  &kp COLON       &kp SEMI                    &kp PRCNT  &kp COMMA  &kp DOT    &kp BSLH  &none
                                         &trans          &trans    &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        sym_ru {
            bindings = <
  &none     &kp RU_LPAR          &en LBRC   &kp RU_RPAR        &en PIPE                       &kp RU_QMARK  &en LBKT      &kp RU_PLUS   &en RBKT    &none
  &en STAR  &hml LSHFT RU_UNDER  &en RBRC   &hml_en LGUI DLLR  &none                          &kp RU_FSLH   &en SQT       &kp RU_MINUS  &kp RU_DQT  &kp RU_EQUAL
  &none     &en TILDE            &en GRAVE  &kp RU_COLON       &kp RU_SEMI                    &kp RU_PRCNT  &kp RU_COMMA  &kp RU_DOT    &en BSLH    &none
                                            &trans             &trans       &trans    &trans  &trans        &trans
            >;

            display-name = "Symbols";
        };

        nav {
            bindings = <
  &none  &kp LG(LS(LBKT))  &kp UP    &kp LG(LS(RBKT))  &none                      &none   &to 0     &to 1      &none      &none
  &none  &kp LEFT          &kp DOWN  &kp RIGHT         &kp TAB                    &none   &kp RGUI  &kp RCTRL  &kp RSHFT  &kp LALT
  &none  &none             &none     &none             &none                      &none   &none     &none      &none      &none
                                     &trans            &trans   &trans    &trans  &trans  &trans
            >;

            display-name = "Nav";
        };

        numbers {
            bindings = <
  &none     &kp LA(LC(LG(LS(N2))))  &kp LG(TAB)  &kp LC(LG(LS(FSLH)))  &kp LA(LC(LG(LS(N1))))                    &none   &kp N7  &kp N8  &kp N9  &none
  &kp LALT  &kp LSHFT               &kp LCTRL    &kp LGUI              &none                                     &none   &kp N4  &kp N5  &kp N6  &none
  &none     &none                   &none        &none                 &none                                     &kp N0  &kp N1  &kp N2  &kp N3  &none
                                                 &trans                &trans                  &trans    &trans  &trans  &trans
            >;

            display-name = "Numbers";
        };

        adj {
            bindings = <
  &none        &none  &none  &none   &none                     &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none
  &bootloader  &none  &none  &none   &none                     &none   &out OUT_BLE  &out OUT_USB  &none         &studio_unlock
  &none        &none  &none  &none   &none                     &none   &none         &bt BT_CLR    &none         &none
                             &trans  &trans  &trans    &trans  &trans  &trans
            >;

            display-name = "Adjust";
        };

        en_letters {
            bindings = <
  &none        &kp W         &hyl 0 F      &kp P        &kp B                                     &kp Z             &kp L        &hyr 0 U      &kp Y         &none
  &hml LALT A  &hml LSHFT R  &hml LCTRL S  &hml LGUI T  &kp G                                     &kp M             &hmr RGUI N  &hmr RCTRL E  &hmr RSHFT I  &hmr LALT O
  &none        &kp X         &kp C         &kp D        &kp V                                     &kp K             &kp H        &kp J         &kp Q         &none
                                           &trans       &ltt 6 SPACE  &ltt 3 ESC    &ltt 3 ENTER  &ltt 5 BACKSPACE  &mo 7
            >;

            display-name = "En letters";
        };
    };
};
