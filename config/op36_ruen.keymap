#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

// The stock "tap-preferred" flavor only reaches the layer after the tapping
// term expires, which would make the layer lag behind a fast opposite-hand
// press. "balanced" lets the layer win as soon as another key is used, while
// quick-tap-ms keeps tap-then-hold repeating the tapped key.
&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        kha {
            bindings = <&kp RU_CYRILLIC_HA>;
            key-positions = <6 7>;
            layers = <1>;
        };

        hrdsgn {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <7 8>;
            layers = <1>;
        };

        cmben {
            bindings = <&layer_en>;
            key-positions = <2 3>;
            layers = <1>;
            require-prior-idle-ms = <150>;
        };

        cmbru {
            bindings = <&layer_ru>;
            key-positions = <2 3>;
            layers = <0>;
            require-prior-idle-ms = <150>;
        };
    };

    macros {
        // Caps Lock switches the input language on macOS and iPadOS. It toggles
        // between the two layouts, so callers must only invoke it when leaving
        // the layer they are currently on.
        os_lang: os_lang {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp CAPS>;
            label = "OS_LANG";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &os_lang>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &os_lang>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&os_lang>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&os_lang>;

            label = "EN";
            wait-ms = <50>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
  &kp Q        &kp W         &kp E         &kp R        &kp T                              &kp Y            &kp U        &kp I         &kp O         &kp P
  &hml LALT A  &hml LSHFT S  &hml LCTRL D  &hml LGUI F  &kp G                              &kp H            &hmr RGUI J  &hmr RCTRL K  &hmr RSHFT L  &hmr LALT SEMICOLON
  &kp Z        &kp X         &kp C         &kp V        &kp B                              &kp N            &kp M        &kp COMMA     &kp DOT       &kp SQT
                                           &none        &lt 4 SPACE  &kp ESC    &kp ENTER  &lt 2 BACKSPACE  &none
            >;

            display-name = "Base";
        };

        ru {
            bindings = <
  &kp RU_CYRILLIC_SHORT_I   &kp RU_CYRILLIC_TSE          &kp RU_CYRILLIC_U          &kp RU_CYRILLIC_KA       &kp RU_CYRILLIC_IE                        &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA        &kp RU_CYRILLIC_SHCHA      &kp RU_CYRILLIC_ZE
  &hml LALT RU_CYRILLIC_EF  &hml LSHFT RU_CYRILLIC_YERU  &hml LCTRL RU_CYRILLIC_VE  &hml LGUI RU_CYRILLIC_A  &kp RU_CYRILLIC_PE                        &kp RU_CYRILLIC_ER  &hmr RGUI RU_CYRILLIC_O    &hmr RCTRL RU_CYRILLIC_EL  &hmr RSHFT RU_CYRILLIC_DE  &hmr LALT RU_CYRILLIC_ZHE
  &kp RU_CYRILLIC_YA        &kp RU_CYRILLIC_CHE          &kp RU_CYRILLIC_ES         &kp RU_CYRILLIC_EM       &kp RU_CYRILLIC_I                         &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE         &kp RU_CYRILLIC_YU         &kp RU_CYRILLIC_E
                                                                                    &none                    &lt 4 SPACE         &kp ESC    &kp ENTER  &lt 3 BACKSPACE     &none
            >;

            display-name = "Ru";
        };

        sym_en {
            bindings = <
  &kp TILDE  &kp LT    &kp EQUAL  &kp GT    &kp GRAVE                      &kp CARET  &kp LBKT  &kp UNDER  &kp RBKT  &kp DLLR
  &kp BSLH   &kp LPAR  &kp MINUS  &kp RPAR  &kp PLUS                       &kp PRCNT  &kp LBRC  &kp SEMI   &kp RBRC  &kp EXCL
  &kp HASH   &kp STAR  &kp COLON  &kp FSLH  &kp AMPS                       &kp AT     &kp PIPE  &kp COMMA  &kp DOT   &kp QMARK
                                  &none     &lt 5 SPACE  &trans    &trans  &none      &none
            >;

            display-name = "Symbols";
        };

        sym_ru {
            bindings = <
  &en TILDE         &en LT    &kp EQUAL     &en GT       &en GRAVE                      &en CARET  &en LBKT  &kp UNDER     &en RBKT    &en DLLR
  &kp RU_BACKSLASH  &kp LPAR  &kp MINUS     &kp RPAR     &kp PLUS                       &kp PRCNT  &en LBRC  &kp RU_SEMI   &en RBRC    &kp EXCL
  &en HASH          &kp STAR  &kp RU_COLON  &kp RU_FSLH  &en AMPS                       &en AT     &en PIPE  &kp RU_COMMA  &kp RU_DOT  &kp RU_QMARK
                                            &none        &lt 5 SPACE  &trans    &trans  &none      &none
            >;

            display-name = "Symbols";
        };

        nav {
            bindings = <
  &kp N1         &kp N2     &kp N3     &kp N4    &kp N5                        &kp N6           &kp N7          &kp N8           &kp N9         &kp N0
  &hml LALT ESC  &kp LSHFT  &kp LCTRL  &kp LGUI  &kp ENTER                     &kp PRINTSCREEN  &hmr RGUI LEFT  &hmr RCTRL DOWN  &hmr RSHFT UP  &hmr LALT RIGHT
  &to 0          &kp HOME   &kp INS    &kp END   &kp DELETE                    &none            &none           &kp PG_DN        &kp PG_UP      &to 1
                                       &none     &none       &trans    &trans  &lt 5 BACKSPACE  &none
            >;

            display-name = "Nav";
        };

        adj {
            bindings = <
  &bootloader  &none  &none  &none  &none                        &bt BT_SEL 0   &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR
  &none        &none  &none  &none  &none                        &out OUT_BLE   &none         &none         &none         &none
  &none        &none  &none  &none  &none                        &out OUT_USB   &none         &none         &none         &studio_unlock
                             &none  &kp SPACE  &trans    &trans  &kp BACKSPACE  &none
            >;

            display-name = "Adjust";
        };
    };
};
